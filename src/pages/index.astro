---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile, paragraphs, listItems } from '../lib/profile';
const profile = loadProfile();
const audience = listItems(profile.audience);
---
<BaseLayout title={`${profile.name} · Home`} description={profile.headline}>
  <section class="card">
    <p style="margin:0;color:var(--accent);font-weight:700">Personal branding site</p>
    <h1>{profile.name}</h1>
    <p style="font-size:1.2rem;color:var(--text)">{profile.headline}</p>
    <p>{paragraphs(profile.bio)[0]}</p>
    <p><strong>Audience</strong></p>
    <ul>
      {audience.map((item) => <li>{item}</li>)}
    </ul>
  </section>
  <section class="grid">
    <a class="card" href="/about"><h2>About</h2><p>เรื่องราวและเส้นทาง</p></a>
    <a class="card" href="/interests"><h2>Interests</h2><p>หัวข้อที่สนใจ</p></a>
    <a class="card" href="/contact"><h2>Contact</h2><p>ส่งข้อความถึงผม</p></a>
  </section>
</BaseLayout>

