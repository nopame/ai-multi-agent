---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile, paragraphs, splitInterest } from '../lib/profile';
const profile = loadProfile();
// D5: About shows interest topics only, linking to the full Interests page.
const topics = profile.interests.map((item) => splitInterest(item).topic);
---
<BaseLayout title={`เกี่ยวกับผม · ${profile.name}`}>
  <article class="card">
    <h1>เกี่ยวกับผม</h1>
    {paragraphs(profile.bio).map((p) => <p>{p}</p>)}
  </article>
  <section class="card">
    <h2>สิ่งที่ผมสนใจ</h2>
    <ul>
      {topics.map((t) => <li>{t}</li>)}
    </ul>
    <p><a href="/interests">ดูว่าผมทำอะไรกับแต่ละเรื่อง</a></p>
  </section>
</BaseLayout>
