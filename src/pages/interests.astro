---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile, splitInterest } from '../lib/profile';
const profile = loadProfile();
const items = profile.interests.map(splitInterest);
---
<BaseLayout title={`ความสนใจ · ${profile.name}`}>
  <section class="card">
    <h1>ความสนใจ</h1>
    <ul class="interests">
      {items.map((i) => (
        <li>
          <strong>{i.topic}</strong>
          {i.detail && <span> — {i.detail}</span>}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .interests { padding-left: 1.2rem; }
  .interests li { margin: 0.6rem 0; }
  .interests strong { color: var(--text); }
</style>
