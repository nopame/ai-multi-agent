---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="ติดต่อ">
  <section class="card">
    <h1>ติดต่อ</h1>
    <p>ฝากข้อความถึงผมได้ที่นี่ครับ</p>
    <form id="contact-form">
      <label for="name">ชื่อ</label>
      <input id="name" name="name" required maxlength="80" autocomplete="name" />
      <label for="email">อีเมล</label>
      <input id="email" name="email" type="email" required maxlength="120" autocomplete="email" />
      <label for="message">ข้อความ</label>
      <textarea id="message" name="message" rows="5" required maxlength="2000"></textarea>
      <!-- honeypot (D9): humans never see/fill this; bots do -->
      <div class="hp" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <p style="margin-top:1rem"><button type="submit" id="contact-submit">ส่งข้อความ</button></p>
      <p id="status" role="status" aria-live="polite"></p>
      <p class="note">ข้อความจะถูกลบภายใน 90 วัน</p>
    </form>
    <!-- shown only when backend returns 501 (stub era) -->
    <div id="contact-fallback" hidden>
      <p>ขณะนี้ฟอร์มติดต่อยังไม่เปิดใช้งานครับ</p>
      <p>ลองกลับมาใหม่ภายหลังนะครับ</p>
    </div>
  </section>
</BaseLayout>
<style>
  .hp {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .note {
    font-size: 0.9rem;
    opacity: 0.8;
  }
</style>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('status');
  const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const fallback = document.getElementById('contact-fallback');
  const GENERIC = 'ส่งข้อความไม่สำเร็จ ลองใหม่อีกครั้งนะครับ';

  const setStatus = (msg: string) => {
    if (status) status.textContent = msg;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const payload = Object.fromEntries(fd.entries());
    setStatus('กำลังส่ง…');
    if (submit) submit.disabled = true;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      let data: unknown = null;
      try {
        data = await res.json();
      } catch {
        data = null;
      }
      if (res.status === 201 || res.ok) {
        setStatus('ได้รับข้อความแล้วครับ');
        form.reset();
        return;
      }
      if (res.status === 501) {
        form.hidden = true;
        if (fallback) fallback.hidden = false;
        return;
      }
      const err =
        data && typeof data === 'object' && typeof (data as { error?: unknown }).error === 'string'
          ? (data as { error: string }).error.trim()
          : '';
      setStatus(err ? `${err} — ลองใหม่อีกครั้งนะครับ` : GENERIC);
    } catch {
      setStatus('เชื่อมต่อไม่ได้ ตรวจสอบอินเทอร์เน็ตแล้วลองใหม่อีกครั้งนะครับ');
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>
