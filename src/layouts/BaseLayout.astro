---
import { loadProfile } from '../lib/profile';

interface Props {
  title?: string;
  description?: string;
}
const profile = loadProfile();
const { title = profile.name, description = profile.headline } = Astro.props;
const path = Astro.url.pathname;
// D5: 4 pages only — Guestbook is Later and stays out of the nav.
const links = [
  { href: '/', label: 'หน้าแรก', current: path === '/' },
  { href: '/about', label: 'เกี่ยวกับผม', current: path.startsWith('/about') },
  { href: '/interests', label: 'ความสนใจ', current: path.startsWith('/interests') },
  { href: '/contact', label: 'ติดต่อ', current: path.startsWith('/contact') },
];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      /* Tone (PROFILE): ฟ้า = หลัก · มิ้นต์ = รอง · ส้ม = ปุ่มติดต่อเท่านั้น (D4) · contrast = Must (D10) */
      :root {
        --bg: #f5f9ff;
        --card: #ffffff;
        --text: #0f172a;
        --muted: #334155;
        --accent: #1d4ed8;
        --accent-soft: #dbeafe;
        --mint: #d1fae5;
        --mint-strong: #047857;
        --cta: #f97316;
        --cta-hover: #ea580c;
        --cta-text: #111827;
        --border: #cbd5e1;
        --focus: #1d4ed8;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Segoe UI", "Noto Sans Thai", "Leelawadee UI", system-ui, sans-serif;
        background:
          radial-gradient(circle at 100% 0, var(--mint) 0, transparent 40%),
          radial-gradient(circle at 0 0, var(--accent-soft) 0, transparent 45%),
          var(--bg);
        color: var(--text);
        min-height: 100vh;
        line-height: 1.6;
      }
      a { color: var(--accent); text-underline-offset: 3px; }
      a:hover { text-decoration-thickness: 2px; }
      :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 6px; }
      .wrap { width: min(920px, 100% - 32px); margin: 0 auto; }
      main { padding: 1.5rem 0 4rem; }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.25rem 1.25rem;
        margin: 1rem 0;
      }
      header.site { border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--card) 80%, transparent); }
      header.site .wrap { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; padding: 0.75rem 0; }
      .brand { font-weight: 800; color: var(--text); text-decoration: none; }
      nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin: 0; padding: 0; list-style: none; }
      nav a { color: var(--muted); font-weight: 600; text-decoration: none; padding: 0.25rem 0; display: inline-block; }
      nav a:hover { color: var(--accent); }
      nav a[aria-current="page"] { color: var(--accent); box-shadow: inset 0 -2px 0 var(--accent); }
      h1, h2 { line-height: 1.25; text-wrap: balance; }
      p, li { color: var(--muted); text-wrap: pretty; }
      .btn-cta {
        display: inline-block; background: var(--cta); color: var(--cta-text);
        font-weight: 700; font-size: 1.05rem; padding: 0.8rem 1.4rem; border-radius: 999px;
        text-decoration: none; border: 0;
      }
      .btn-cta:hover { background: var(--cta-hover); }
      .tag { display: inline-block; background: var(--mint); color: var(--mint-strong); font-weight: 700; font-size: 0.85rem; padding: 0.15rem 0.6rem; border-radius: 999px; }
      input, textarea {
        font: inherit; border-radius: 10px; border: 1px solid #94a3b8;
        background: #fff; color: var(--text); padding: 0.7rem 0.9rem; width: 100%;
      }
      label { display: block; margin: 0.75rem 0 0.35rem; color: var(--text); font-weight: 600; }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">{profile.name}</a>
        <nav aria-label="หลัก">
          <ul>
            {links.map((l) => (
              <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>
