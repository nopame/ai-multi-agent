---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'nopame', description = 'Full-stack developer ที่วางระบบให้ทีม AI agent ส่งงานครบทุกชั้น' } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'หน้าแรก', match: (p: string) => p === '/' },
  { href: '/about', label: 'เกี่ยวกับ', match: (p: string) => p.startsWith('/about') },
  { href: '/interests', label: 'ความสนใจ', match: (p: string) => p.startsWith('/interests') },
  { href: '/contact', label: 'ติดต่อ', match: (p: string) => p.startsWith('/contact') },
  { href: '/guestbook', label: 'สมุดเยี่ยม', match: (p: string) => p.startsWith('/guestbook') },
];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      /* Tone (PROFILE): ฟ้าหลัก · มิ้นต์รอง · ส้มเฉพาะปุ่มติดต่อ (D4) · พื้นสว่าง ตัวอักษรเข้ม (D11) */
      :root {
        --bg: #f4f8ff;
        --card: #ffffff;
        --text: #0f172a;
        --muted: #334155;
        --accent: #1d4ed8;
        --accent-soft: #dbeafe;
        --mint: #0f766e;
        --mint-soft: #d5f5ec;
        --cta: #c2410c;
        --cta-hover: #9a3412;
        --border: #d6e2f5;
        --danger: #b91c1c;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Segoe UI", "Noto Sans Thai", system-ui, sans-serif;
        background: linear-gradient(180deg, #e8f1ff 0, var(--bg) 320px);
        color: var(--text);
        min-height: 100vh;
        line-height: 1.6;
      }
      a { color: var(--accent); text-underline-offset: 3px; }
      a:hover { color: #1e3a8a; }
      :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
      .wrap { width: min(920px, 100% - 32px); margin: 0 auto; }
      main { padding: 1.5rem 0 4rem; }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        margin: 1rem 0;
        box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
      }
      header.site { border-bottom: 1px solid var(--border); background: rgb(255 255 255 / 0.7); }
      nav { display: flex; gap: 0.25rem 1rem; flex-wrap: wrap; align-items: center; padding: 0.75rem 0; }
      nav .brand {
        font-weight: 800; color: var(--text); text-decoration: none; margin-right: auto;
        min-height: 44px; display: inline-flex; align-items: center;
      }
      nav a.link {
        color: var(--muted); font-weight: 600; text-decoration: none;
        padding: 0.5rem 0.25rem; min-height: 44px; display: inline-flex; align-items: center;
      }
      nav a.link[aria-current="page"] { color: var(--accent); box-shadow: inset 0 -3px 0 var(--accent); }
      h1, h2, h3 { line-height: 1.25; color: var(--text); }
      p, li { color: var(--muted); }
      input, textarea, button { font: inherit; }
      input, textarea {
        border-radius: 10px; border: 1px solid #94a3b8; background: #fff; color: var(--text);
        padding: 0.7rem 0.9rem; width: 100%;
      }
      label { display: block; margin: 0.9rem 0 0.35rem; color: var(--text); font-weight: 600; }
      .btn {
        display: inline-flex; align-items: center; justify-content: center; min-height: 48px;
        padding: 0.7rem 1.4rem; border-radius: 999px; border: 0; font-weight: 700;
        text-decoration: none; cursor: pointer;
      }
      .btn-primary { background: var(--accent); color: #fff; }
      .btn-primary:hover { background: #1e3a8a; color: #fff; }
      /* ส้มสงวนไว้ให้ปุ่มติดต่อเท่านั้น (D4) */
      .btn-cta { background: var(--cta); color: #fff; }
      .btn-cta:hover { background: var(--cta-hover); color: #fff; }
      .btn[disabled] { opacity: 0.6; cursor: progress; }
      .hint { font-size: 0.9rem; color: var(--muted); margin: 0.35rem 0 0; }
      .status { margin: 0.75rem 0 0; font-weight: 600; }
      .status.ok { color: var(--mint); }
      .status.err { color: var(--danger); }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
      .tag {
        display: inline-block; background: var(--mint-soft); color: #065f46; font-weight: 600;
        border-radius: 999px; padding: 0.15rem 0.7rem; font-size: 0.9rem;
      }
      /* honeypot: ซ่อนจากผู้ใช้และ screen reader แต่ bot ยังเห็นในฟอร์ม */
      .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
      /* มือถือ: brand แถวบน · ลิงก์ทั้ง 5 แถวล่าง · ลด padding ให้เนื้อหากว้างขึ้น */
      @media (max-width: 600px) {
        nav { gap: 0 0.9rem; padding: 0.25rem 0 0; }
        nav .brand { flex-basis: 100%; min-height: 40px; }
        nav a.link { font-size: 0.95rem; padding: 0.4rem 0; }
        main { padding-top: 0.75rem; }
        .card { padding: 1rem 1.1rem; border-radius: 14px; }
      }
      footer.site { border-top: 1px solid var(--border); padding: 1.25rem 0 2rem; font-size: 0.9rem; }
    </style>
  </head>
  <body>
    <header class="site">
      <nav class="wrap" aria-label="หลัก">
        <a class="brand" href="/">nopame</a>
        {links.map((l) => (
          <a class="link" href={l.href} aria-current={l.match(path) ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap"><p>© nopame · เว็บนี้สร้างด้วย Astro และ SQLite</p></div>
    </footer>
  </body>
</html>
